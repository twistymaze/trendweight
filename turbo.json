{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "**/bin/**", "**/obj/**", ".next/**", "*.tsbuildinfo", "src/routeTree.gen.ts"],
      "env": [
        "VITE_*",
        "BUILD_*"
      ]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", "**/coverage.cobertura.xml"],
      "cache": false
    },
    "lint": {
      "dependsOn": ["typecheck"],
      "inputs": [
        "**/*.js",
        "**/*.jsx", 
        "**/*.ts",
        "**/*.tsx",
        "**/*.cs",
        "**/package.json",
        "**/tsconfig.json",
        "**/.eslintrc*",
        "**/eslint.config.*",
        "**/.prettierrc*",
        "**/prettier.config.*",
        "$TURBO_ROOT$/.editorconfig",
        "**/*.csproj",
        "**/*.sln",
        "**/packages.lock.json",
        "**/Directory.Build.props",
        "**/nuget.config",
        "$TURBO_ROOT$/global.json"
      ]
    },
    "typecheck": {
      "dependsOn": ["generate-routes"],
      "inputs": [
        "**/*.ts",
        "**/*.tsx",
        "**/*.d.ts",
        "**/tsconfig.json",
        "**/tsconfig.*.json",
        "**/*.cs",
        "**/*.csproj",
        "**/*.sln",
        "$TURBO_ROOT$/global.json"
      ]
    },
    "generate-routes": {
      "inputs": [
        "src/routes/**/*.tsx"
      ],
      "outputs": ["src/routeTree.gen.ts"]
    },
    "format": {
      "outputs": [],
      "cache": false
    },
    "format:check": {
      "inputs": [
        "**/*.js",
        "**/*.jsx",
        "**/*.ts", 
        "**/*.tsx",
        "**/*.json",
        "**/*.css",
        "**/*.md",
        "**/*.cs",
        ".prettierrc*",
        "prettier.config.*",
        "$TURBO_ROOT$/.editorconfig",
        "**/packages.lock.json",
        "**/Directory.Build.props",
        "**/nuget.config",
        "$TURBO_ROOT$/global.json"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
