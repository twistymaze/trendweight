{
  "openapi": "3.1.1",
  "info": {
    "title": "TrendWeight API",
    "description": "Programmatic access to your own TrendWeight data: read your measurements, and add or edit weight log entries.\n\nAuthenticate every request with the API key from your [settings page](/settings), sent as \u0060Authorization: Bearer sk-...\u0060 (or in an \u0060X-Api-Key\u0060 header).\n\nAll weights are in kilograms, and body fat values are 0\u20131 ratios (0.225 means 22.5%).",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://canonical.example"
    }
  ],
  "paths": {
    "/api/v1/measurements/manual": {
      "get": {
        "tags": [
          "Manual Weight Log"
        ],
        "summary": "List manual entries",
        "description": "Returns the weight entries that were added manually (in the app or through this\nAPI), newest first. Readings synced from a scale (Withings, Fitbit) are not\nincluded - get those from \u0022Get raw scale readings\u0022.",
        "operationId": "listManualEntries",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ManualReading"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ManualReading"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ManualReading"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Manual Weight Log"
        ],
        "summary": "Add or replace manual entries in bulk",
        "description": "Creates or replaces manual entries for multiple dates in one call. The whole\nbatch is validated first; nothing is stored unless every entry is valid.",
        "operationId": "upsertManualEntries",
        "requestBody": {
          "description": "Entries to upsert (max 1000, one per date)",
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ManualBatchEntry"
                }
              }
            },
            "text/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ManualBatchEntry"
                }
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ManualBatchEntry"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ManualReading"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ManualReading"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ManualReading"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/measurements/manual/{date}": {
      "put": {
        "tags": [
          "Manual Weight Log"
        ],
        "summary": "Add or replace a manual entry",
        "description": "Creates or replaces the manual entry for the given date. Idempotent - safe to\nretry. Only manual entries can be written through the API; readings synced from\na scale (Withings, Fitbit) cannot be edited.",
        "operationId": "upsertManualEntry",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "description": "Date of the entry (yyyy-MM-dd, user\u0027s local timezone)",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Entry values (weight in kg, fat as a 0-1 ratio)",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualUpsertRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualUpsertRequest"
              }
            },
            "application/*\u002Bjson": {
              "schema": {
                "$ref": "#/components/schemas/ManualUpsertRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ManualReading"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualReading"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ManualReading"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Manual Weight Log"
        ],
        "summary": "Delete a manual entry",
        "description": "Deletes the manual entry for the given date. Returns 404 if no manual entry\nexists for that date (readings synced from a scale cannot be deleted here).",
        "operationId": "deleteManualEntry",
        "parameters": [
          {
            "name": "date",
            "in": "path",
            "description": "Date of the entry (yyyy-MM-dd)",
            "required": true,
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/measurements": {
      "get": {
        "tags": [
          "Weight Data"
        ],
        "summary": "Get weight data",
        "description": "Returns your daily weight data with trend values applied, refreshing from\nconnected scales first if their data is stale. This is the combined view of all\nsources. For the raw readings behind it, see \u0022Get raw scale readings\u0022 and the\nManual Weight Log operations. All weights are kilograms; body fat is a 0-1 ratio.",
        "operationId": "getWeightData",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "Only return measurements on or after this date (yyyy-MM-dd)",
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Measurement"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/measurements/sources": {
      "get": {
        "tags": [
          "Weight Data"
        ],
        "summary": "Get raw scale readings",
        "description": "Returns the raw readings exactly as reported by each scale source (Withings,\nFitbit, and legacy TrendWeight data), refreshing from connected scales first if\ntheir data is stale - the API equivalent of the per-source views on the download\npage. Manual entries are not included here; use the Manual Weight Log operations\nfor those.",
        "operationId": "listSourceReadings",
        "parameters": [
          {
            "name": "since",
            "in": "query",
            "description": "Only return readings on or after this date (yyyy-MM-dd)",
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "description": "Only return readings from this source (withings, fitbit, or legacy)",
            "schema": {
              "pattern": "^(withings|fitbit|legacy)$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceData"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceData"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SourceData"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Get display and behavioral settings",
        "description": "Read-only preferences for the API key owner. Sharing need not be enabled.\nUnlike the measurement endpoints, goalWeight and plannedWeightChangePerWeek\nuse the user\u0027s display units: kilograms when useMetric is true, pounds otherwise.\nValues match the settings screen without conversion. Unset goals are omitted.\nAccount details, sharing settings, and credentials are never included.",
        "operationId": "getSettings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/Settings"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EntryError": {
        "required": [
          "index",
          "error"
        ],
        "type": "object",
        "properties": {
          "index": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Zero-based index of the failing entry in the submitted array",
            "format": "int32"
          },
          "error": {
            "type": "string",
            "description": "What is wrong with this entry"
          }
        },
        "description": "A validation error for one entry of a batch request"
      },
      "ErrorResponse": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Human-readable description of what went wrong"
          },
          "errors": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/EntryError"
            },
            "description": "Per-entry errors for batch requests"
          }
        },
        "description": "Error details. For batch requests, per-entry errors are listed with their\nzero-based index into the submitted array."
      },
      "ManualBatchEntry": {
        "required": [
          "date",
          "weight"
        ],
        "type": "object",
        "properties": {
          "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string",
            "description": "Date of the entry (yyyy-MM-dd, user\u0027s local timezone)"
          },
          "weight": {
            "exclusiveMaximum": 700,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Weight in kilograms",
            "format": "double"
          },
          "fatRatio": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Body fat as a 0-1 ratio (e.g. 0.225 for 22.5%), not a percentage",
            "format": "double"
          }
        },
        "description": "One entry in a batch upsert"
      },
      "ManualReading": {
        "required": [
          "date",
          "weight"
        ],
        "type": "object",
        "properties": {
          "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string",
            "description": "Date of the entry (yyyy-MM-dd, user\u0027s local timezone)"
          },
          "weight": {
            "exclusiveMaximum": 700,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Weight in kilograms",
            "format": "double"
          },
          "fatRatio": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Body fat as a 0-1 ratio (e.g. 0.225 for 22.5%), when recorded",
            "format": "double"
          }
        },
        "description": "One weight log entry (a manually entered reading). One entry per date."
      },
      "ManualUpsertRequest": {
        "required": [
          "weight"
        ],
        "type": "object",
        "properties": {
          "weight": {
            "exclusiveMaximum": 700,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Weight in kilograms (convert before submitting; the API is always metric)",
            "format": "double"
          },
          "fatRatio": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Body fat as a 0-1 ratio (e.g. 0.225 for 22.5%), not a percentage",
            "format": "double"
          }
        },
        "description": "Values for creating or replacing the weight log entry for a date"
      },
      "Measurement": {
        "required": [
          "date",
          "actualWeight",
          "trendWeight",
          "weightIsInterpolated",
          "fatIsInterpolated"
        ],
        "type": "object",
        "properties": {
          "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string",
            "description": "Date of the measurement (yyyy-MM-dd, user\u0027s local timezone)"
          },
          "actualWeight": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Actual (or interpolated) scale weight in kilograms",
            "format": "double"
          },
          "trendWeight": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Exponentially-smoothed trend weight in kilograms",
            "format": "double"
          },
          "weightIsInterpolated": {
            "type": "boolean",
            "description": "True if the weight for this day was interpolated rather than measured"
          },
          "fatIsInterpolated": {
            "type": "boolean",
            "description": "True if the fat reading for this day was interpolated rather than measured"
          },
          "actualFatPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Actual body fat as a 0-1 ratio, when available",
            "format": "double"
          },
          "trendFatPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Trend body fat as a 0-1 ratio, when available",
            "format": "double"
          },
          "trendFatMass": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Trend fat mass in kilograms, when available",
            "format": "double"
          },
          "trendLeanMass": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Trend lean mass in kilograms, when available",
            "format": "double"
          }
        },
        "description": "One computed daily measurement"
      },
      "RawMeasurement": {
        "required": [
          "date",
          "time",
          "weight"
        ],
        "type": "object",
        "properties": {
          "date": {
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string",
            "description": "Date of the reading (yyyy-MM-dd, user\u0027s local timezone)"
          },
          "time": {
            "pattern": "^\\d{2}:\\d{2}:\\d{2}$",
            "type": "string",
            "description": "Time of the reading (HH:mm:ss)"
          },
          "weight": {
            "exclusiveMaximum": 700,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Weight in kilograms",
            "format": "double"
          },
          "fatRatio": {
            "exclusiveMaximum": 1,
            "exclusiveMinimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Body fat as a 0-1 ratio, when reported",
            "format": "double"
          }
        },
        "description": "One raw reading as reported by a source"
      },
      "Settings": {
        "required": [
          "trendAlgorithm"
        ],
        "type": "object",
        "properties": {
          "goalStart": {
            "type": [
              "null",
              "string"
            ],
            "description": "Goal start date (yyyy-MM-dd), omitted when unset."
          },
          "goalWeight": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Goal weight in kilograms when useMetric is true, otherwise pounds. Omitted when unset.",
            "format": "double"
          },
          "plannedWeightChangePerWeek": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Planned weekly weight change in kilograms when useMetric is true, otherwise pounds. Negative means loss, positive means gain, zero means maintenance. Omitted when unset.",
            "format": "double"
          },
          "useMetric": {
            "type": "boolean",
            "description": "Whether the user displays metric units. Determines the units of goalWeight and plannedWeightChangePerWeek in this response."
          },
          "dayStartOffset": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Hour (0-23) at which a measurement day starts in the user\u0027s local time.",
            "format": "int32"
          },
          "showCalories": {
            "type": "boolean",
            "description": "Whether to display calorie estimates."
          },
          "hideDataBeforeStart": {
            "type": "boolean",
            "description": "Whether to hide measurements before the goal start date."
          },
          "trendAlgorithm": {
            "type": "string",
            "description": "Effective trend preset: default, holt-gentle, holt, or holt-responsive."
          }
        },
        "description": "Behavioral and display preferences, without account or sharing details."
      },
      "SourceData": {
        "required": [
          "provider",
          "lastUpdate",
          "measurements"
        ],
        "type": "object",
        "properties": {
          "provider": {
            "pattern": "^(withings|fitbit|legacy)$",
            "type": "string",
            "description": "The source these readings came from: \u0022withings\u0022, \u0022fitbit\u0022, or \u0022legacy\u0022"
          },
          "lastUpdate": {
            "type": "string",
            "description": "When this source last synced (UTC)",
            "format": "date-time"
          },
          "measurements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RawMeasurement"
            },
            "description": "Raw measurements, newest first"
          }
        },
        "description": "Raw readings from one scale source"
      }
    },
    "securitySchemes": {
      "API Key": {
        "type": "http",
        "description": "Your TrendWeight API key from the settings page",
        "scheme": "bearer",
        "bearerFormat": "sk-..."
      }
    }
  },
  "security": [
    {
      "API Key": []
    }
  ],
  "tags": [
    {
      "name": "Weight Data",
      "description": "Your daily weight data with trend math applied (combined from every source), plus the raw readings from each connected scale."
    },
    {
      "name": "Manual Weight Log",
      "description": "Weight entries added manually - in the app or through this API. These endpoints do not cover readings synced from Withings or Fitbit; those are read-only and appear under Weight Data."
    }
  ]
}
